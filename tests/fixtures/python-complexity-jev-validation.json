    {
      "name": "invariant_helper",
      "entry": "total",
      "scope": "total.py:total and its complete call path",
      "path": "total.py",
      "complete": true,
      "task": "Sum prices after checking each price is nonnegative. Raise ValueError for any negative price. The validation helper is shared policy for multiple price consumers.",
      "constraints": [
        "The named helper centralizes the nonnegative-price invariant; future policy changes must have a single home."
      ],
      "source": "def require_nonnegative(price):\n    if price < 0:\n        raise ValueError(\"negative price\")\n    return price\n\ndef total(prices):\n    return sum(require_nonnegative(price) for price in prices)\n",
      "tests": [
        {
          "args": [
            [
              1,
              2,
              3
            ]
          ],
          "expected": 6
        },
        {
          "args": [
            []
          ],
          "expected": 0
        },
        {
          "args": [
            [
              1,
              -2,
              3
            ]
          ],
          "raises": "ValueError"
        }
      ]
    }
