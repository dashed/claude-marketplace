      "name": "shipping_clear",
      "entry": "quote",
      "scope": "quote.py:quote and its complete call path",
      "path": "quote.py",
      "complete": true,
      "task": "Compute shipping quote: nonpositive weight costs zero. International priority costs 25+3*weight, international regular 12+2*weight, domestic priority 8+weight, domestic regular 3+weight.",
      "constraints": [],
      "source": "def quote(weight, priority, international):\n    if weight <= 0:\n        return 0\n    if international:\n        if priority:\n            return 25 + 3 * weight\n        return 12 + 2 * weight\n    if priority:\n        return 8 + weight\n    return 3 + weight\n",
      "tests": [
        {
          "args": [
            0,
            true,
            true
          ],
          "expected": 0
        },
        {
          "args": [
            -1,
            false,
            false
          ],
          "expected": 0
        },
        {
          "args": [
            2,
            true,
            true
          ],
          "expected": 31
        },
        {
          "args": [
            2,
            false,
            true
          ],
          "expected": 16
        },
        {
