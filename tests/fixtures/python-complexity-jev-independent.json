      "path": "safe_short_circuit.py",
      "complete": true,
      "task": "Return whether samples have a positive count and their average does not exceed limit. A zero or negative count must return false without division.",
      "constraints": [],
      "source": "def within_limit(total, count, limit):\n    return count > 0 and total / count <= limit\n",
