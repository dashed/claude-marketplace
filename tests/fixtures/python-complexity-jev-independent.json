    {
      "name": "guard_ladder",
      "entry": "issue_credit",
      "scope": "guard_ladder.py complete shown call path",
      "path": "guard_ladder.py",
      "complete": true,
      "task": "Return the requested positive credit amount only for an active, verified account with credit enabled and enough balance; otherwise return zero. Fields are always present.",
      "constraints": [
        "The function is pure; no cleanup, side effects, or external hooks must be preserved."
      ],
      "source": "def issue_credit(account, amount):\n    if account[\"active\"]:\n        if account[\"verified\"]:\n            if account[\"credit_enabled\"]:\n                if amount > 0:\n                    if account[\"balance\"] >= amount:\n                        return amount\n    return 0\n",
      "tests": [
        {
          "args": [
            {
              "active": true,
              "verified": true,
              "credit_enabled": true,
              "balance": 20
            },
            10
          ],
          "expected": 10
        },
        {
          "args": [
            {
              "active": true,
              "verified": true,
              "credit_enabled": true,
              "balance": 20
            },
            21
          ],
          "expected": 0
        },
        {
          "args": [
            {
              "active": true,
              "verified": true,
              "credit_enabled": true,
              "balance": 20
            },
            0
          ],
          "expected": 0
        },
        {
          "args": [
            {
              "active": false,
              "verified": true,
              "credit_enabled": true,
              "balance": 20
            },
            10
          ],
          "expected": 0
        },
        {
          "args": [
            {
              "active": true,
              "verified": false,
              "credit_enabled": true,
              "balance": 20
            },
            10
          ],
          "expected": 0
        },
        {
          "args": [
            {
              "active": true,
              "verified": true,
              "credit_enabled": false,
              "balance": 20
            },
            10
          ],
          "expected": 0
        }
      ]
    },
    {
      "name": "grouped_totals",
      "entry": "totals",
      "scope": "grouped_totals.py complete shown call path",
      "path": "grouped_totals.py",
      "complete": true,
      "task": "Return each group's sum of positive item amounts. Keep empty groups with total zero and keep group boundaries distinct. Inputs are a mapping from group names to lists of integers.",
      "constraints": [],
      "source": "def totals(groups):\n    result = {}\n    for name, amounts in groups.items():\n        subtotal = 0\n        for amount in amounts:\n            if amount > 0:\n                subtotal += amount\n        result[name] = subtotal\n    return result\n",
      "tests": [
        {
          "args": [
            {}
          ],
          "expected": {}
        },
        {
          "args": [
            {
              "a": [
                3,
                -2,
                4
              ],
              "b": [],
              "c": [
                8,
                0
              ]
            }
          ],
          "expected": {
            "a": 7,
            "b": 0,
            "c": 8
          }
        },
        {
          "args": [
            {
              "a": [
                -1
              ],
              "b": [
                2
              ]
            }
          ],
          "expected": {
            "a": 0,
            "b": 2
          }
        }
      ]
    },
    {
      "name": "scoped_lifetimes",
      "entry": "serve",
      "scope": "scoped_lifetimes.py complete shown call path",
      "path": "scoped_lifetimes.py",
      "complete": true,
      "task": "Acquire a transaction and then a lock; optionally do work, then release the lock before the transaction, including if work later raises. Return the audit log. The lease helper models resource acquisition and guaranteed release.",
      "constraints": [
        "Acquisition order and LIFO cleanup are contractual."
      ],
      "source": "from contextlib import contextmanager\n\n@contextmanager\ndef lease(log, name):\n    log.append(\"acquire:\" + name)\n    try:\n        yield\n    finally:\n        log.append(\"release:\" + name)\n\ndef serve(enabled):\n    log = []\n    with lease(log, \"transaction\"):\n        with lease(log, \"lock\"):\n            if enabled:\n                log.append(\"work\")\n    return log\n",
      "tests": [
        {
          "args": [
            false
          ],
          "expected": [
            "acquire:transaction",
            "acquire:lock",
            "release:lock",
            "release:transaction"
          ]
        },
        {
          "args": [
            true
          ],
          "expected": [
            "acquire:transaction",
            "acquire:lock",
            "work",
            "release:lock",
            "release:transaction"
          ]
        }
      ]
    },
    {
