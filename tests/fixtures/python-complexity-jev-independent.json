    {
      "name": "shared_policy",
      "entry": "probe",
      "scope": "shared_policy.py complete shown call path",
      "path": "shared_policy.py",
      "complete": true,
      "task": "Return the value and presence of a case-insensitive, whitespace-trimmed name in a mapping whose stored keys are already canonical. The application's public lookup and contains APIs are used independently; probe combines their results for inspection.",
      "constraints": [
        "Keep the independently used lookup and contains API boundaries and one shared canonicalization policy."
      ],
      "source": "def canonical_name(name):\n    return name.strip().casefold()\n\ndef lookup(rows, name):\n    return rows.get(canonical_name(name))\n\ndef contains(rows, name):\n    return canonical_name(name) in rows\n\ndef probe(rows, name):\n    return [lookup(rows, name), contains(rows, name)]\n",
      "tests": [
        {
          "args": [
            {
              "alice": 12
            },
            " ALICE "
          ],
          "expected": [
            12,
            true
          ]
        },
        {
          "args": [
            {
              "alice": 12
            },
            "bob"
          ],
          "expected": [
            null,
            false
          ]
        },
        {
          "args": [
            {
              "empty": null
            },
            "EMPTY"
          ],
          "expected": [
            null,
            true
          ]
        },
        {
          "args": [
            {},
            ""
          ],
          "expected": [
            null,
            false
          ]
        }
      ]
    },
    {
      "name": "forwarding_chain",
      "entry": "probe",
      "scope": "forwarding_chain.py complete shown call path",
      "path": "forwarding_chain.py",
      "complete": true,
      "task": "Return the value and presence of a case-insensitive, whitespace-trimmed name in a mapping whose stored keys are already canonical. Only probe is public.",
      "constraints": [
        "There are no framework hooks, instrumentation, alternative dispatchers, or external consumers of the private helpers."
      ],
      "source": "def probe(rows, name):\n    return _dispatch(rows, name)\n\ndef _dispatch(rows, name):\n    return _route(rows, name)\n\ndef _route(rows, name):\n    return _read(rows, name)\n\ndef _read(rows, name):\n    key = name.strip().casefold()\n    return [rows.get(key), key in rows]\n",
      "tests": [
        {
          "args": [
            {
              "alice": 12
            },
            " ALICE "
          ],
          "expected": [
            12,
            true
          ]
        },
