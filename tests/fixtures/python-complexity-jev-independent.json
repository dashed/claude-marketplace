          "args": [
            {
              "empty": null
            },
            "EMPTY"
          ],
          "expected": [
            null,
            true
          ]
        },
        {
          "args": [
            {},
            ""
          ],
          "expected": [
            null,
            false
          ]
        }
      ]
    }
